# -- App ----------------------------------------------------------
# Base URL of the application (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -- API ----------------------------------------------------------
# Base URL for internal API routes
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
